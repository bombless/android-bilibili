# 服务运行端口
PORT=3000

# OpenAI 兼容 Chat Completions 配置
# 支持 OpenAI, DeepSeek, Moonshot (Kimi), SiliconFlow (硅基流动), Ollama 等
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 用户偏好设置（以逗号分隔，供大模型与规则匹配分析）
DEFAULT_PREFERENCES=科技前沿, 数码测评, 编程开发, 硬件极客, 游戏解说, 硬核科普

# 默认关注/常看创作者（未登录状态下会以此名单抓取近期作品，并拓展抓取相关推荐）
DEFAULT_FOLLOWED_CREATORS=影视飓风, 极客湾Geekerwan, 老师好我叫何同学, 稚晖君, 罗翔说刑法, 泛式

# 是否默认启用关注视频的相关视频拓展 (true/false)
EXPAND_RELATED_VIDEOS=true

# 每次推荐返回的视频数量
RECOMMEND_PAGE_SIZE=10
